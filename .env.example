# ==============================================================================
# Mahathi Tailor Shop - Environment Configuration Template
# ==============================================================================
# 
# Copy this file to `.env` and fill in the values below.
# If these variables are left empty, the application will automatically fall back 
# to a simulated local storage state, ensuring all features remain functional out of the box.

# Supabase Client Integration Credentials (API Client)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase PostgreSQL Database URI Connection String (Schema Deployer)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Location: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=your_supabase_database_uri_here
